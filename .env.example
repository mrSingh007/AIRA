# Copy to .env. Generate each value with: openssl rand -hex 32
# Keep APP_SECRET stable: existing stored credentials cannot be decrypted after rotation.
APP_SECRET=replace-with-at-least-32-random-characters
# Use URL-safe characters, such as the output of openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-random-database-password
KANGENTIX_PORT=3000
KANGENTIX_BIND=127.0.0.1
# Required fixed browser origin (no path/query). Use http://localhost:5173 for npm run dev.
APP_URL=http://localhost:3000
# HTTPS APP_URL automatically enables Secure cookies; true forces them on HTTP too.
COOKIE_SECURE=false
# Enable only behind one trusted reverse proxy with no direct client access to the app.
TRUST_PROXY=false
RUN_TIMEOUT_SECONDS=900
# Optional: pin the CLI version used when building the shared agent image.
CLAUDE_CODE_VERSION=latest
# Docker Desktop and standard Docker Engine normally use this socket.
DOCKER_SOCKET=/var/run/docker.sock
# For npm run dev outside Docker, set a reachable PostgreSQL connection string:
# DATABASE_URL=postgresql://kangentix:password@localhost:5432/kangentix
# SANDBOX_DOCKER_IMAGE=kangentix-sandbox:local
# GitHub, Ollama Cloud or Claude, and E2B keys are configured per project in the UI, not in this file.
